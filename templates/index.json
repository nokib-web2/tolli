    "tolli_faq": {
      "type": "tolli-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What's the difference between Hydration and Clear Protein?",
            "answer": "<p><strong>tolli Hydration</strong> (Strawberry Lemonade) is an electrolyte drink mix with 5 electrolytes, 3 vitamins and zero sugar, 15 servings per pack.</p><p><strong>tolli Clear Protein</strong> (Raspberry Lemonade) is a refreshing protein water with 22g protein per serving, zero sugar and vitamin C, 10 servings per pack.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How do I make it?",
            "answer": "<p>Add one serving to cold water and stir or shake. Check the pack for the recommended amount of water per serving.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "When should I drink tolli?",
            "answer": "<p>Hydration is made for everyday refreshment: busy workdays, hot days or after exercise. Clear Protein is a light way to add protein, for example after a workout or between meals.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Is tolli vegan?",
            "answer": "<p>Yes. Both tolli Hydration and tolli Clear Protein are plant based and vegan.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Does tolli contain sugar?",
            "answer": "<p>No. Both ranges are zero sugar.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Where do you deliver and how long does it take?",
            "answer": "<p>Add your delivery areas, times and costs here.</p>"
          }
        }
      },
