{% render 'tolli-section-style', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .tolli-benefits {
    --tolli-btn-bg: {{ section.settings.button_bg }};
    --tolli-btn-color: {{ section.settings.button_text }};
  }
{%- endstyle -%}

<style>
  .tolli-benefits {
    position: relative;
  }
  .tolli-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tolli-benefit {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.6rem 1.4rem 1.8rem;
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }
  .tolli-benefit:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.1);
  }
  .tolli-benefit__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 0 0 3px var(--benefit-color);
    color: var(--tolli-navy);
    transform: rotate(-6deg);
  }
  .tolli-benefit:nth-child(even) .tolli-benefit__icon {
    transform: rotate(6deg);
  }
  .tolli-benefit__icon svg,
  .tolli-benefit__icon img {
    width: 2.8rem;
    height: 2.8rem;
    object-fit: contain;
  }
  .tolli-benefit__stat {
    display: block;
    font-family: var(--tolli-font-display);
    font-size: 3.2rem;
    line-height: 1;
    color: var(--benefit-color);
  }
  .tolli-benefit__title {
    margin: 0;
    color: inherit;
    font-family: var(--tolli-font-display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.1;
  }
  .tolli-benefit__text {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.45;
    opacity: 0.82;
  }
  .tolli-benefits__action {
    margin-top: 3.2rem;
    text-align: center;
  }
  .tolli-benefits .tolli-btn {
    width: auto;
    padding: 0.9rem 3.2rem;
  }

  @media screen and (max-width: 379px) {
    .tolli-benefits__grid {
      grid-template-columns: 1fr;
    }
  }
  @media screen and (min-width: 750px) {
    .tolli-benefits__grid {
      gap: 2rem;
    }
    .tolli-benefit {
      padding: 2.8rem 2.4rem 3.2rem;
      gap: 1.4rem;
    }
    .tolli-benefit__icon {
      width: 6.4rem;
      height: 6.4rem;
      border-radius: 1.2rem;
    }
    .tolli-benefit__icon svg,
    .tolli-benefit__icon img {
      width: 3.8rem;
      height: 3.8rem;
    }
    .tolli-benefit__stat {
      font-size: 4.4rem;
    }
    .tolli-benefit__title {
      font-size: 2.4rem;
    }
    .tolli-benefit__text {
      font-size: 1.6rem;
    }
    .tolli-benefits__action {
      margin-top: 4.8rem;
    }
  }
  @media screen and (min-width: 990px) {
    .tolli-benefits__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }
</style>

<div class="tolli-section tolli-has-decor tolli-section--dark tolli-benefits">
  {% render 'tolli-section-decor', section: section %}

  <div class="tolli-container">
    {% render 'tolli-section-head', section: section %}

    <ul class="tolli-benefits__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="tolli-benefit" style="--benefit-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
          <span class="tolli-benefit__icon" aria-hidden="true">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'tolli-icon', icon: block.settings.icon %}
            {%- endif -%}
          </span>
          {%- if block.settings.stat != blank -%}
            <span class="tolli-benefit__stat">{{ block.settings.stat | escape }}</span>
          {%- endif -%}
          <h3 class="tolli-benefit__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="tolli-benefit__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="tolli-benefits__action">
        <a class="tolli-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.button_label | escape }}</span>
          {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

