        },
        {
          "value": "custom",
          "label": "Custom image"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Custom background image"
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background image opacity",
      "default": 100
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Background image position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "bg_fixed",
      "label": "Fixed background while scrolling",
      "info": "Parallax effect: the image stays still and the page scrolls over it.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "wave_top",
      "label": "Wavy top edge",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "wave_bottom",
      "label": "Wavy bottom edge",
      "default": false
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Top wave colour",
      "info": "Match the background of the section above.",
      "default": "#FFFDF7"
    },
    {
      "type": "color",
      "id": "wave_bottom_color",
      "label": "Bottom wave colour",
      "info": "Match the background of the section below.",
      "default": "#FFFDF7"
    }
  ],
  "presets": [
    {
      "name": "Tolli image banner"
    }
  ]
}
{% endschema %}
