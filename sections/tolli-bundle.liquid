  "tag": "div",
  "class": "tolli-bundle-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in [brackets] to highlight them.",
      "default": "Better [together.]"
    },
    {
      "type": "checkbox",
      "id": "show_burst",
      "label": "Show accent strokes after heading",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "One of each. Your feel-good duo."
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Heading size on mobile",
      "info": "Scales down automatically on narrow phones.",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 26,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 44
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "paragraph",
      "content": "Desktop shows the image between the copy and the price. Mobile shows it as a banner on top. Use an image whose background matches the card colour so it blends in."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
