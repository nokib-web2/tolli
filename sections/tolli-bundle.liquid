{%- liquid
  assign heading_html = section.settings.heading | escape | replace: '[', '<span class="tolli-hl">' | replace: ']', '</span>'

  assign total_cents = 0
  assign all_available = true
  for p in section.settings.products
    assign total_cents = total_cents | plus: p.selected_or_first_available_variant.price
    unless p.selected_or_first_available_variant.available
      assign all_available = false
    endunless
  endfor

  assign price_text = section.settings.price_override
  if price_text == blank and total_cents > 0
    if section.settings.price_prefix != blank
      assign price_text = total_cents | money_without_currency | prepend: section.settings.price_prefix
    else
      assign price_text = total_cents | money
    endif
  endif

  assign button_url = section.settings.button_link | default: routes.all_products_collection_url

  assign use_add_all = false
  if section.settings.button_action == 'add_all' and section.settings.products.size > 0 and all_available
    assign use_add_all = true
  endif

  assign image_alt = section.settings.text | default: 'Tolli duo'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .tolli-bundle {
    --bundle-bg: {{ section.settings.card_bg }};
    --bundle-text: {{ section.settings.text_color }};
    --bundle-hl: {{ section.settings.highlight_color }};
    --bundle-burst: {{ section.settings.burst_color }};
    --bundle-price: {{ section.settings.price_color }};
    --bundle-radius: {{ section.settings.card_radius }}px;
    --bundle-h-m: {{ section.settings.heading_size_mobile }}px;
    --bundle-h-d: {{ section.settings.heading_size_desktop }}px;
    --bundle-max: {{ section.settings.max_width }}px;
    --bundle-ratio-m: {{ section.settings.mobile_image_ratio }};
    --bundle-focal: {{ section.settings.focal_x }}% 50%;
    --bundle-img-w: {{ section.settings.image_width_desktop }}%;
    --bundle-h: {{ section.settings.desktop_height }}px;
    --tolli-btn-bg: {{ section.settings.button_bg }};
    --tolli-btn-color: {{ section.settings.button_text }};
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tolli-bundle {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<style>
  .tolli-bundle__card {
    max-width: var(--bundle-max);
    margin: 0 auto;
    border-radius: var(--bundle-radius);
    background: var(--bundle-bg);
    color: var(--bundle-text);
    overflow: hidden;
  }

  /* Mobile & tablet: image banner on top, copy + price, full-width button */
  .tolli-bundle__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'media media'
      'copy price'
      'action action';
    align-items: center;
    gap: 1.2rem 1.6rem;
    padding: 0 1.8rem 1.8rem;
  }
  .tolli-bundle__media {
    grid-area: media;
    margin: 0 -1.8rem;
    aspect-ratio: var(--bundle-ratio-m);
    overflow: hidden;
  }
  .tolli-bundle__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--bundle-focal);
  }
  .tolli-bundle__media .tolli-bundle__img--mobile ~ img {
    display: none;
  }
  .tolli-bundle__copy {
    grid-area: copy;
  }
  .tolli-bundle__buy {
    display: contents;
  }
  .tolli-bundle__price-wrap {
    grid-area: price;
  }
  .tolli-bundle__action {
    grid-area: action;
  }

  .tolli-bundle__heading {
    font-size: min(var(--bundle-h-m), 6.2vw);
    color: var(--bundle-text);
  }
  .tolli-bundle__heading .tolli-hl {
    color: var(--bundle-hl);
  }
  .tolli-bundle__heading .tolli-burst {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.04em;
    margin-top: -0.12em;
    vertical-align: top;
    color: var(--bundle-burst);
  }
  .tolli-bundle__text {
    margin: 0.4rem 0 0;
    font-size: min(1.5rem, 3.6vw);
    line-height: 1.3;
  }
  .tolli-bundle__price-label {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--bundle-price);
  }
  .tolli-bundle__price {
    margin: 0;
    font-size: clamp(2.4rem, 7.4vw, 3.6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--bundle-price);
    white-space: nowrap;
  }
  .tolli-bundle .tolli-btn {
    min-height: 4.4rem;
    border-radius: 1.2rem;
    font-size: 1.6rem;
  }
  .tolli-bundle .tolli-btn[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  .tolli-bundle__error {
    margin: 0.8rem 0 0;
    font-size: 1.4rem;
    color: var(--bundle-price);
  }

  @media screen and (max-width: 359px) {
    .tolli-bundle__inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'copy' 'price' 'action';
    }
  }

  @media screen and (min-width: 750px) {
    .tolli-bundle__inner {
      gap: 2rem 3.2rem;
      padding: 0 3.2rem 3.2rem;
    }
    .tolli-bundle__media {
      margin: 0 -3.2rem;
    }
    .tolli-bundle__heading {
      font-size: var(--bundle-h-d);
    }
    .tolli-bundle__text {
      font-size: 1.9rem;
    }
    .tolli-bundle__price-label {
      font-size: 1.8rem;
    }
    .tolli-bundle__price {
      font-size: 5.2rem;
    }
    .tolli-bundle .tolli-btn {
      min-height: 5.2rem;
      font-size: 1.8rem;
    }
  }

  /* Desktop banner: copy | duo image | price + button */
  @media screen and (min-width: 990px) {
    .tolli-bundle__inner {
      grid-template-columns: minmax(0, 1fr) var(--bundle-img-w) auto;
      grid-template-areas: 'copy media buy';
      min-height: var(--bundle-h);
      gap: 2.4rem;
      padding: 0 clamp(2.4rem, 3vw, 4.8rem);
    }
    .tolli-bundle__media {
      align-self: stretch;
      margin: 0;
      aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 10%, #000 90%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 10%, #000 90%, transparent 100%);
    }
    .tolli-bundle__media .tolli-bundle__img--mobile {
      display: none;
    }
    .tolli-bundle__media .tolli-bundle__img--mobile ~ img {
      display: block;
    }
    .tolli-bundle__copy {
      padding: 3.2rem 0;
    }
    .tolli-bundle__heading {
      font-size: min(var(--bundle-h-d), 3.2vw);
    }
    .tolli-bundle__text {
      font-size: min(1.9rem, 1.4vw);
    }
    .tolli-bundle__buy {
      grid-area: buy;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-self: end;
      padding: 3.2rem 0;
    }
    .tolli-bundle__price {
      font-size: min(5.2rem, 3.8vw);
    }
    .tolli-bundle__action {
      margin-top: 1.6rem;
    }
    .tolli-bundle .tolli-btn {
      min-width: 22rem;
      padding: 0.9rem 2.4rem;
    }
  }
</style>

<section class="tolli-section tolli-has-decor tolli-bundle">
  {% render 'tolli-section-decor', section: section %}
  <div class="tolli-container">
    <div class="tolli-bundle__card">
      <div class="tolli-bundle__inner">
        <div class="tolli-bundle__media">
          {%- if section.settings.mobile_image != blank -%}
            {{ section.settings.mobile_image | image_url: width: 1200 | image_tag: class: 'tolli-bundle__img--mobile', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 1px, 100vw', loading: 'lazy', alt: image_alt }}
          {%- endif -%}
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '500, 800, 1100, 1400, 1800, 2400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: image_alt }}
          {%- else -%}
            <img src="{{ 'tolli-bundle-bg.jpg' | asset_url }}" width="2170" height="725" loading="lazy" alt="{{ image_alt | escape }}">
          {%- endif -%}
        </div>

        <div class="tolli-bundle__copy">
          {%- if section.settings.heading != blank -%}
            <h2 class="tolli-display tolli-bundle__heading">
              {{ heading_html }}
              {%- if section.settings.show_burst -%}
                <span class="tolli-burst" aria-hidden="true">{% render 'tolli-icon', icon: 'burst-small' %}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="tolli-bundle__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        <div class="tolli-bundle__buy">
          {%- if price_text != blank -%}
            <div class="tolli-bundle__price-wrap">
              {%- if section.settings.price_label != blank -%}
                <p class="tolli-bundle__price-label">{{ section.settings.price_label | escape }}</p>
              {%- endif -%}
              <p class="tolli-bundle__price">{{ price_text }}</p>
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="tolli-bundle__action">
              {%- if use_add_all -%}
                <a
                  class="tolli-btn"
                  href="{{ button_url }}"
                  data-tolli-add-all='[{%- for p in section.settings.products -%}{"id":{{ p.selected_or_first_available_variant.id }},"quantity":1}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]'
                >
                  <span>{{ section.settings.button_label | escape }}</span>
                  {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
                </a>
                <p class="tolli-bundle__error" role="alert" hidden></p>
              {%- else -%}
                <a class="tolli-btn" href="{{ button_url }}">
                  <span>{{ section.settings.button_label | escape }}</span>
                  {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- if use_add_all -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      var btn = root && root.querySelector('[data-tolli-add-all]');
      if (!btn) return;
      var error = root.querySelector('.tolli-bundle__error');
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        btn.setAttribute('aria-busy', 'true');
        if (error) error.hidden = true;
        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: JSON.parse(btn.dataset.tolliAddAll), sections: 'cart-drawer,cart-icon-bubble', sections_url: window.location.pathname })
        })
          .then(function (response) {
            return response.json().then(function (data) {
              if (!response.ok) throw new Error(data.description || data.message);
              return data;
            });
          })
          .then(function (data) {
            var drawer = document.querySelector('cart-drawer');
            btn.removeAttribute('aria-busy');
            if (drawer && typeof drawer.renderContents === 'function' && data.sections) {
              try {
                drawer.classList.remove('is-empty');
                drawer.renderContents(data);
                return;
              } catch (e) { /* fall through to the cart page */ }
            }
            window.location.href = '{{ routes.cart_url }}';
          })
          .catch(function (err) {
            btn.removeAttribute('aria-busy');
            if (error) {
              error.textContent = err.message || 'Something went wrong. Please try again.';
              error.hidden = false;
            }
          });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
