{% render 'tolli-section-style', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .tolli-steps {
    --step-circle: {{ section.settings.circle_color }};
    --step-badge: {{ section.settings.badge_color }};
    --step-line: {{ section.settings.line_color }};
    --tolli-btn-bg: {{ section.settings.button_bg }};
    --tolli-btn-color: {{ section.settings.button_text }};
  }
{%- endstyle -%}

<style>
  .tolli-steps__list {
    position: relative;
    display: grid;
    gap: 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: tolli-step;
  }
  .tolli-steps__list::before {
    content: '';
    position: absolute;
    top: 3.2rem;
    bottom: 3.2rem;
    left: 3.2rem;
    border-left: 3px dashed var(--step-line);
  }
  .tolli-step {
    position: relative;
    display: grid;
    grid-template-columns: 6.4rem minmax(0, 1fr);
    align-items: center;
    gap: 1.6rem;
    counter-increment: tolli-step;
  }
  .tolli-step__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 6.4rem;
    border-radius: 50%;
    background: var(--step-circle);
    color: var(--tolli-navy);
    box-shadow: 0 1rem 2rem rgba(0, 62, 85, 0.1);
  }
  .tolli-step__icon svg,
  .tolli-step__icon img {
    width: 3.4rem;
    height: 3.4rem;
    object-fit: contain;
  }
  .tolli-step__icon::after {
    content: counter(tolli-step);
    position: absolute;
    top: -0.4rem;
    right: -0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--step-badge);
    color: #fff;
    font-family: var(--tolli-font-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .tolli-step__title {
    margin: 0;
    color: inherit;
    font-family: var(--tolli-font-display);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.1;
  }
  .tolli-step__text {
    margin: 0.4rem 0 0;
    font-size: 1.5rem;
    line-height: 1.45;
    opacity: 0.85;
  }
  .tolli-steps__action {
    margin-top: 3.2rem;
    text-align: center;
  }
  .tolli-steps .tolli-btn {
    width: auto;
    padding: 0.9rem 3.2rem;
  }

  @media screen and (min-width: 750px) {
    .tolli-steps__list {
      grid-template-columns: repeat(var(--step-count), minmax(0, 1fr));
      gap: 3.2rem;
    }
    .tolli-steps__list::before {
      top: 5.6rem;
      bottom: auto;
      left: calc(50% / var(--step-count));
      right: calc(50% / var(--step-count));
      border-left: 0;
      border-top: 3px dashed var(--step-line);
    }
    .tolli-step {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 2rem;
    }
    .tolli-step__icon {
      width: 11.2rem;
      height: 11.2rem;
    }
    .tolli-step__icon svg,
    .tolli-step__icon img {
      width: 5.6rem;
      height: 5.6rem;
    }
    .tolli-step__icon::after {
      top: 0;
      right: 0;
      width: 3.4rem;
      height: 3.4rem;
      font-size: 2rem;
    }
    .tolli-step__title {
      font-size: 2.8rem;
    }
    .tolli-step__text {
      max-width: 32rem;
      margin: 0.8rem auto 0;
      font-size: 1.7rem;
    }
    .tolli-steps__action {
      margin-top: 4.8rem;
    }
  }
</style>

<div class="tolli-section tolli-has-decor tolli-steps">
  {% render 'tolli-section-decor', section: section %}
  <div class="tolli-container">
    {% render 'tolli-section-head', section: section %}

    <ol class="tolli-steps__list" role="list" style="--step-count: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="tolli-step" {{ block.shopify_attributes }}>
          <span class="tolli-step__icon" aria-hidden="true">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 200 | image_tag: width: 100, height: 100, loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'tolli-icon', icon: block.settings.icon %}
            {%- endif -%}
          </span>
          <div>
            <h3 class="tolli-step__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="tolli-step__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="tolli-steps__action">
        <a class="tolli-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.button_label | escape }}</span>
          {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

