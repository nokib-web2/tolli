      "default": false
    },
    {
      "type": "checkbox",
      "id": "wave_top",
      "label": "Wavy top edge",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "wave_bottom",
      "label": "Wavy bottom edge",
      "default": false
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Top wave colour",
      "info": "Match the background of the section above.",
      "default": "#FFFDF7"
    },
    {
      "type": "color",
      "id": "wave_bottom_color",
      "label": "Bottom wave colour",
      "info": "Match the background of the section below.",
      "default": "#FFFDF7"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Title, image, price and link come from this product unless overridden below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "A transparent PNG of the pouch looks best."
        },
        {
          "type": "select",
          "id": "placeholder",
          "label": "Preview pouch (used when there is no image)",
          "options": [
            {
              "value": "hydration",
              "label": "Strawberry Lemonade hydration"
            },
            {
              "value": "protein",
              "label": "Raspberry Lemonade clear protein"
            }
          ],
          "default": "hydration"
        },
        {
          "type": "checkbox",
          "id": "blend_image",
          "label": "Blend white image background into card",
          "info": "Turn on if the product photo has a white background.",
          "default": false
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card background",
          "default": "#E8F7F1"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label above title",
          "default": "Daily Hydration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "default": "Strawberry Lemonade"
        },
        {
          "type": "textarea",
          "id": "details",
          "label": "Details",
          "info": "Each line shows on its own line.",
          "default": "5 electrolytes + 3 vitamins\n15 servings"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Launch price"
        },
        {
          "type": "text",
          "id": "price_override",
          "label": "Price override",
          "info": "Leave empty to use the product price."
        },
        {
          "type": "range",
          "id": "servings",
          "min": 0,
          "max": 60,
          "step": 1,
          "label": "Servings per pack",
          "info": "Used to calculate the per-serving price. 0 hides it.",
          "default": 15
        },
        {
          "type": "text",
          "id": "per_serving_override",
          "label": "Per-serving text override",
          "info": "Leave empty to calculate it from the product price."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop hydration"
        },
        {
          "type": "select",
          "id": "button_action",
          "label": "Button action",
          "options": [
            {
              "value": "link",
              "label": "Go to product / link"
            },
            {
              "value": "add_to_cart",
              "label": "Add product to cart"
            }
          ],
          "default": "link"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Defaults to the product page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tolli product cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card",
          "settings": {
            "placeholder": "protein",
            "card_bg": "#FDECF1",
            "eyebrow": "Clear Protein",
            "title": "Raspberry Lemonade",
            "details": "22g protein • 10 servings",
            "servings": 10,
            "button_label": "Shop clear protein"
          }
        }
      ]
    }
  ]
}
{% endschema %}
