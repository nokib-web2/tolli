      "type": "image_picker",
      "id": "bg_image",
      "label": "Custom background image"
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background image opacity",
      "default": 100
    },
    {
