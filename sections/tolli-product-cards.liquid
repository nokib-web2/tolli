{%- liquid
  assign heading_html = section.settings.heading | escape | replace: '[', '<span class="tolli-hl">' | replace: ']', '</span>'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .tolli-cards {
    --cards-h-m: {{ section.settings.heading_size_mobile }}px;
    --cards-h-d: {{ section.settings.heading_size_desktop }}px;
    --cards-cols-d: {{ section.settings.columns_desktop }};
    --cards-gap: {{ section.settings.gap }}px;
    --cards-radius: {{ section.settings.card_radius }}px;
    --cards-hl: {{ section.settings.highlight_color }};
    --cards-text: {{ section.settings.text_color }};
    --cards-price: {{ section.settings.price_color }};
    --tolli-btn-bg: {{ section.settings.button_bg }};
    --tolli-btn-color: {{ section.settings.button_text }};
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tolli-cards {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<style>
  .tolli-cards__heading {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin: 0 0 1.6rem;
    font-size: var(--cards-h-m);
    color: var(--cards-text);
    text-align: center;
  }
  .tolli-cards__heading .tolli-hl {
    color: var(--cards-hl);
  }
  .tolli-cards__heading .tolli-burst {
    width: 0.6em;
    height: 0.6em;
    margin-left: 0.04em;
    margin-top: -0.06em;
    color: var(--cards-hl);
  }
  .tolli-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--cards-gap) * 0.75);
  }

  .tolli-card {
    display: grid;
    grid-template-columns: 44% 1fr;
    align-items: center;
    gap: 1.2rem;
    padding: 1.2rem 1.4rem 1.2rem 1.2rem;
    border-radius: var(--cards-radius);
    background: var(--card-bg);
    color: var(--cards-text);
    overflow: hidden;
  }
  .tolli-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    min-height: 15rem;
  }
  .tolli-card__media img {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 1rem 1.2rem rgba(0, 30, 45, 0.16));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tolli-card--blend .tolli-card__media img {
    mix-blend-mode: multiply;
    filter: none;
  }
  .tolli-card:hover .tolli-card__media img {
    transform: translateY(-4px) rotate(-1.5deg);
  }
  .tolli-card__body {
    min-width: 0;
  }
  .tolli-card__eyebrow {
    margin: 0 0 0.2rem;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .tolli-card__title {
    margin: 0;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
    font-size: clamp(1.9rem, 5.4vw, 2.6rem);
    line-height: 1.02;
  }
  .tolli-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .tolli-card__details {
    margin: 0.5rem 0 0;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .tolli-card__price-label {
    margin: 0.8rem 0 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--cards-price);
    line-height: 1.2;
  }
  .tolli-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.8rem;
    margin: 0.1rem 0 0;
    font-size: clamp(2.8rem, 8.4vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--cards-price);
  }
  .tolli-card__compare {
    font-size: 0.45em;
    font-weight: 700;
    color: var(--cards-text);
    opacity: 0.55;
  }
  .tolli-card__per {
    margin: 0.3rem 0 0;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--cards-price);
  }
  .tolli-card .tolli-btn {
    margin-top: 1rem;
    min-height: 4rem;
    padding: 0.7rem 1rem;
    gap: 0.4em;
    font-size: clamp(1.3rem, 3.7vw, 1.5rem);
    border-radius: 1rem;
  }
  @media screen and (min-width: 360px) {
    .tolli-card .tolli-btn {
      white-space: nowrap;
    }
  }

  @media screen and (min-width: 750px) {
    .tolli-cards__heading {
      font-size: var(--cards-h-d);
      margin-bottom: 3.2rem;
    }
    .tolli-cards__grid {
      gap: var(--cards-gap);
    }
    .tolli-card {
      gap: 2.4rem;
      padding: 2.4rem 2.8rem 2.4rem 2.4rem;
    }
    .tolli-card__media {
      min-height: 24rem;
    }
    .tolli-card__media img {
      max-width: 26rem;
    }
    .tolli-card__eyebrow {
      font-size: 1.7rem;
    }
    .tolli-card__title {
      font-size: 3.2rem;
    }
    .tolli-card__details,
    .tolli-card__per {
      font-size: 1.7rem;
    }
    .tolli-card__price-label {
      font-size: 1.7rem;
      margin-top: 1.2rem;
    }
    .tolli-card__price {
      font-size: 4.8rem;
    }
    .tolli-card .tolli-btn {
      margin-top: 1.6rem;
      min-height: 4.8rem;
      font-size: 1.8rem;
      border-radius: 1.2rem;
    }
  }
  @media screen and (min-width: 990px) {
    .tolli-cards__grid {
      grid-template-columns: repeat(var(--cards-cols-d), minmax(0, 1fr));
    }
  }
</style>

<section class="tolli-section tolli-has-decor tolli-cards">
  {% render 'tolli-section-decor', section: section %}
  <div class="tolli-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="tolli-display tolli-cards__heading">
        <span>{{ heading_html }}</span>
        {%- if section.settings.show_burst -%}
          <span class="tolli-burst" aria-hidden="true">{% render 'tolli-icon', icon: 'burst-small' %}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    <div class="tolli-cards__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          assign variant = card_product.selected_or_first_available_variant

          assign card_url = block.settings.button_link
          if card_url == blank and card_product != blank
            assign card_url = card_product.url
          endif
          if card_url == blank
            assign card_url = routes.all_products_collection_url
          endif

          assign title = block.settings.title
          if title == blank and card_product != blank
            assign title = card_product.title
          endif

          assign price_text = block.settings.price_override
          assign compare_text = ''
          if price_text == blank and card_product != blank
            if section.settings.price_prefix != blank
              assign price_text = variant.price | money_without_currency | prepend: section.settings.price_prefix
            else
              assign price_text = variant.price | money
            endif
            if section.settings.show_compare and variant.compare_at_price > variant.price
              if section.settings.price_prefix != blank
                assign compare_text = variant.compare_at_price | money_without_currency | prepend: section.settings.price_prefix
              else
                assign compare_text = variant.compare_at_price | money
              endif
            endif
          endif

          assign per_text = block.settings.per_serving_override
          assign card_servings = card_product.metafields.tolli.servings.value | default: block.settings.servings | plus: 0
          if per_text == blank and card_product != blank and card_servings > 0
            assign per_cents = variant.price | divided_by: card_servings
            if section.settings.price_prefix != blank
              assign per_money = per_cents | money_without_currency | prepend: section.settings.price_prefix
            else
              assign per_money = per_cents | money
            endif
            assign per_text = section.settings.per_serving_format | replace: '[price]', per_money
          endif
        -%}
        <article
          class="tolli-card{% if block.settings.blend_image %} tolli-card--blend{% endif %}"
          style="--card-bg: {{ block.settings.card_bg }};"
          {{ block.shopify_attributes }}
        >
          <a class="tolli-card__media" href="{{ card_url }}" tabindex="-1" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '250, 350, 500, 700', sizes: '(min-width: 750px) 280px, 44vw', loading: 'lazy', alt: '' }}
            {%- elsif card_product.featured_image != blank -%}
              {{ card_product.featured_image | image_url: width: 700 | image_tag: widths: '250, 350, 500, 700', sizes: '(min-width: 750px) 280px, 44vw', loading: 'lazy', alt: '' }}
            {%- elsif block.settings.placeholder == 'protein' -%}
              <img src="{{ 'tolli-pouch-protein.png' | asset_url }}" width="293" height="366" alt="" loading="lazy">
            {%- else -%}
              <img src="{{ 'tolli-pouch-hydration.png' | asset_url }}" width="374" height="522" alt="" loading="lazy">
            {%- endif -%}
          </a>

          <div class="tolli-card__body">
            {%- if block.settings.eyebrow != blank -%}
              <p class="tolli-card__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if title != blank -%}
              <h3 class="tolli-display tolli-card__title">
                <a href="{{ card_url }}">{{ title | escape }}</a>
              </h3>
            {%- endif -%}
            {%- if block.settings.details != blank -%}
              <p class="tolli-card__details">{{ block.settings.details | escape | newline_to_br }}</p>
            {%- endif -%}
            {%- if block.settings.price_label != blank -%}
              <p class="tolli-card__price-label">{{ block.settings.price_label | escape }}</p>
            {%- endif -%}
            {%- if price_text != blank -%}
              <p class="tolli-card__price">
                <span>{{ price_text }}</span>
                {%- if compare_text != blank -%}
                  <s class="tolli-card__compare">{{ compare_text }}</s>
                {%- endif -%}
              </p>
            {%- endif -%}
            {%- if per_text != blank -%}
              <p class="tolli-card__per">{{ per_text | escape }}</p>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              {%- if block.settings.button_action == 'add_to_cart' and card_product != blank and variant.available -%}
                {%- form 'product', card_product -%}
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="tolli-btn">
                    <span>{{ block.settings.button_label | escape }}</span>
                    {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
                  </button>
                {%- endform -%}
              {%- else -%}
                <a class="tolli-btn" href="{{ card_url }}">
                  <span>{{ block.settings.button_label | escape }}</span>
                  {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
                </a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tolli product cards",
  "tag": "div",
  "class": "tolli-product-cards-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in [brackets] to highlight them.",
      "default": "Pick your [sip.]"
    },
    {
      "type": "checkbox",
      "id": "show_burst",
      "label": "Show accent strokes after heading",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size on mobile",
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading size on desktop",
      "default": 64
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Cards per row on desktop (990px and wider)",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between cards",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Prices"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Currency prefix",
      "info": "E.g. S$. Leave empty to use the store's money format.",
      "default": "S$"
    },
    {
      "type": "text",
      "id": "per_serving_format",
      "label": "Per-serving text",
      "info": "[price] is replaced with price ÷ servings (set servings on each card).",
      "default": "[price] per serving"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare-at price when on sale",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFDF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#003E55"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Heading highlight colour",
      "default": "#ED0056"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price colour",
      "default": "#ED0056"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#003E55"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding on mobile",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding on mobile",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Top padding on desktop",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding on desktop",
      "default": 24
    },
    {
      "type": "header",
      "content": "Background & edges"
    },
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background image",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "leaves",
          "label": "Sunny leaves (built-in)"
