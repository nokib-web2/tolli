{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .main-page-{{ section.id }} .main-page__inner {
    max-width: {{ section.settings.text_max_width | default: 90 }}rem;
  }
  .main-page-{{ section.id }}.main-page--centered .main-page__inner {
    margin: 0 auto;
  }
{%- endstyle -%}

<div class="page-width{% if section.settings.content_width == 'narrow' %} page-width--narrow{% endif %} main-page-{{ section.id }}{% if section.settings.content_width != 'header' %} main-page--centered{% endif %} section-{{ section.id }}-padding">
  <div class="main-page__inner">
  <h1 class="main-page-title page-title h0">
    {{ page.title | escape }}
  </h1>
  <div class="rte">
    {{ page.content }}
  </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "header", "label": "Aligned with header" },
        { "value": "centered", "label": "Header width, text centred" },
        { "value": "narrow", "label": "Narrow (original)" }
      ],
      "default": "header"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 60,
      "max": 140,
      "step": 2,
      "unit": "rem",
      "label": "Maximum text width",
      "info": "Keeps long text easy to read. The title and text still start at the header's left edge.",
      "default": 90
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
