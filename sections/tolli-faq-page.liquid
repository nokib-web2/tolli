{%- comment -%}
  Tolli FAQ page
  - Full-bleed hero background image set from the editor (floats under a transparent header);
    the leaves backdrop stands in as a placeholder until one is uploaded
  - Three FAQ categories, each one white accordion card with line icons and doodle bursts
  - "Still curious?" contact banner and "Pick your sip." product cards
  - Desktop: sticky category sidebar that highlights the category in view
{%- endcomment -%}

{%- liquid
  assign cat_keys = 'drinks,mix,orders' | split: ','
  assign cat_default_titles = 'The drinks|Mix & sip|Orders & delivery' | split: '|'
  assign cat_default_icons = 'strawberry-line,cup-line,truck-line' | split: ','
  assign cat_bursts = 'yellow,yellow,pink' | split: ','

  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .tfaq {
    --faq-bg: {{ section.settings.background | default: '#FFFDF7' }};
    --faq-top-offset: {% if is_first %}var(--tolli-header-offset, 0px){% else %}0px{% endif %};
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
  }
  #shopify-section-{{ section.id }} .tfaq__hero {
    padding-top: calc(var(--faq-top-offset) + {{ section.settings.padding_top_mobile | default: 24 }}px);
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tfaq {
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    }
    #shopify-section-{{ section.id }} .tfaq__hero {
      padding-top: calc(var(--faq-top-offset) + {{ section.settings.padding_top_desktop | default: 48 }}px);
    }
  }
{%- endstyle -%}

<style>
  .tfaq {
    --faq-navy: var(--tolli-navy, #003E55);
    --faq-navy-rgb: var(--tolli-navy-rgb, 0, 62, 85);
    --faq-pink: var(--tolli-pink, #ED0056);
    --faq-mint: var(--tolli-mint, #E8F7F1);
    --faq-blush: var(--tolli-blush, #FDECF1);
    --faq-yellow: var(--tolli-yellow, #FFDC32);
    --faq-max: 112rem;
    background: var(--faq-bg);
    color: var(--faq-navy);
    overflow: hidden;
    overflow: clip;
    interpolate-size: allow-keywords;
  }
  .tfaq h1,
  .tfaq h2,
  .tfaq h3,
  .tfaq p {
    margin: 0;
  }

  /* Doodle bursts */
  .tfaq__burst {
    display: inline-block;
    flex: none;
    width: 0.62em;
    height: 0.62em;
    color: var(--faq-pink);
    pointer-events: none;
  }
  .tfaq__burst svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tfaq__burst--yellow {
    color: var(--faq-yellow);
  }

  /* ---------- Hero ---------- */
  .tfaq__hero {
    position: relative;
    isolation: isolate;
    padding-bottom: 5.2rem;
    background: var(--faq-bg);
  }
  .tfaq__hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }
  .tfaq__hero-bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--faq-hero-focal, left top);
  }
  .tfaq__hero-bg--mobile {
    display: none;
  }
  .tfaq__hero-bg--has-mobile + .tfaq__hero-bg--mobile {
    display: block;
  }
  @media screen and (max-width: 749px) {
    .tfaq__hero-bg--has-mobile {
      display: none;
    }
  }
  @media screen and (min-width: 750px) {
    .tfaq__hero-bg--has-mobile + .tfaq__hero-bg--mobile {
      display: none;
    }
  }
  .tfaq__strawberry {
    position: absolute;
    pointer-events: none;
    filter: drop-shadow(0 0.6rem 0.8rem rgba(120, 20, 30, 0.18));
  }
  .tfaq__hero-inner {
    position: relative;
  }
  .tfaq__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.6rem;
    font-family: var(--tolli-font-body);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--faq-pink);
  }
  .tfaq__eyebrow .tfaq__burst {
    width: 2rem;
    height: 2rem;
    margin-left: -0.2rem;
    transform: scaleX(-1) rotate(-8deg);
  }
  .tfaq__title {
    font-family: var(--tolli-font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 8.2vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--faq-navy);
  }
  .tfaq__title-line {
    display: block;
    white-space: nowrap;
  }
  .tfaq__title-line--hl {
    color: var(--faq-pink);
  }
  .tfaq__title .tfaq__burst {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.18em;
    vertical-align: -0.02em;
    transform: rotate(78deg);
  }
  .tfaq__subtitle {
    margin-top: 0.9rem !important;
    max-width: 60%;
    font-family: var(--tolli-font-body);
    font-size: clamp(1.4rem, 3.75vw, 2.2rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--faq-navy);
  }
  @media screen and (min-width: 400px) {
    .tfaq__subtitle {
      max-width: none;
    }
  }
  .tfaq__wave {
    position: absolute;
    left: 0;
    bottom: -1px;
    z-index: 1;
    display: block;
    width: 100%;
    height: 3.6rem;
    color: var(--faq-bg);
    pointer-events: none;
  }
  .tfaq__wave path {
    fill: currentColor;
  }

  /* Category pills (tablet hero) */
  .tfaq__pills {
    display: none;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }
  .tfaq__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    padding: 0.6rem 1.8rem 0.6rem 1.2rem;
    border-radius: 99rem;
    border: 1.5px solid rgba(var(--faq-navy-rgb), 0.12);
    background: rgba(255, 255, 255, 0.86);
    font-family: var(--tolli-font-body);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--faq-navy);
    text-decoration: none;
    backdrop-filter: blur(6px);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .tfaq__pill svg {
    width: 2.6rem;
    height: 2.6rem;
    color: var(--faq-pink);
  }
  .tfaq__pill:hover {
    border-color: var(--faq-pink);
    color: var(--faq-pink);
    transform: translateY(-2px);
  }

  /* ---------- Body layout ---------- */
  .tfaq__body {
    position: relative;
  }
  .tfaq__layout {
    max-width: var(--faq-max);
    margin: 0 auto;
  }
  .tfaq__nav {
    display: none;
  }
  .tfaq__groups {
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
  }

  /* ---------- Category ---------- */
  .tfaq__group {
    position: relative;
    isolation: isolate;
    scroll-margin-top: calc(var(--header-height, 7rem) + 1.6rem);
  }
  .tfaq__group-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .tfaq__group-icon {
    flex: none;
    width: 4.6rem;
    height: 4.6rem;
    color: var(--faq-pink);
  }
  .tfaq__group-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .tfaq__group-title {
    display: inline-flex;
    align-items: flex-start;
    font-family: var(--tolli-font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 7.6vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--faq-navy);
  }
  .tfaq__group-title .tfaq__burst {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.3em;
    margin-top: -0.2em;
  }

  /* Leaf sprig + mint wash beside "Mix & sip" */
  .tfaq__leaves {
    position: absolute;
    z-index: 0;
    top: -3.6rem;
    right: calc(-1 * var(--tolli-gutter, 1.5rem) - 1.2rem);
    width: 8.4rem;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 0.4rem 0.6rem rgba(30, 90, 50, 0.12));
  }
  .tfaq__wash {
    position: absolute;
    z-index: -1;
    top: -2.4rem;
    right: calc(-1 * var(--tolli-gutter, 1.5rem));
    width: 78%;
    height: calc(100% + 4rem);
    color: var(--faq-mint);
    pointer-events: none;
  }

  /* Accordion card */
  .tfaq__list {
    position: relative;
    z-index: 1;
    background: #fff;
    border: 1px solid rgba(var(--faq-navy-rgb), 0.1);
    border-radius: 1.4rem;
    box-shadow: 0 0.4rem 1.6rem rgba(var(--faq-navy-rgb), 0.04);
    overflow: hidden;
  }
  .tfaq__item + .tfaq__item {
    border-top: 1px solid rgba(var(--faq-navy-rgb), 0.09);
  }
  .tfaq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.3rem 1.6rem 1.3rem 1.8rem;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }
  .tfaq__q::-webkit-details-marker {
    display: none;
  }
  .tfaq__q::marker {
    content: '';
  }
  .tfaq__q:focus-visible {
    outline: 2px solid var(--faq-pink);
    outline-offset: -3px;
    border-radius: 1.2rem;
  }
  .tfaq__q-text {
    font-family: var(--tolli-font-body);
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--faq-navy);
    transition: color 0.2s ease;
  }
  .tfaq__q:hover .tfaq__q-text,
  .tfaq__item[open] .tfaq__q-text {
    color: var(--faq-pink);
  }
  .tfaq__chev {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    color: var(--faq-navy);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s ease;
  }
  .tfaq__item[open] .tfaq__chev {
    transform: rotate(180deg);
    color: var(--faq-pink);
  }
  .tfaq__a {
    padding: 0 4.8rem 1.4rem 1.8rem;
    margin-top: -0.5rem;
    font-family: var(--tolli-font-body);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--faq-navy);
  }
  .tfaq__a p + p {
    margin-top: 0.8rem;
  }
  .tfaq__a a {
    color: var(--faq-pink);
    font-weight: 700;
  }
  /* Smooth open/close where supported */
  .tfaq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
  }
  .tfaq__item[open]::details-content {
    block-size: auto;
  }

  /* ---------- Still curious? ---------- */
  .tfaq__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    max-width: var(--faq-max);
    margin: 2.4rem auto 0;
    padding: 1.8rem 1.6rem 1.8rem 2rem;
    border-radius: 1.6rem;
    background: var(--faq-blush);
  }
  .tfaq__contact-title {
    display: inline-flex;
    align-items: flex-start;
    font-family: var(--tolli-font-display);
    font-weight: 400;
    font-size: clamp(2.3rem, 6.4vw, 4rem);
    line-height: 1.05;
    white-space: nowrap;
    color: var(--faq-navy);
  }
  .tfaq__contact-title .tfaq__burst {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.25em;
    margin-top: -0.15em;
  }
  .tfaq__contact-text {
    margin-top: 0.2rem !important;
    font-size: clamp(1.5rem, 4.1vw, 2rem);
    line-height: 1.3;
  }
  .tfaq .tfaq__contact .tolli-btn {
    flex: none;
    width: auto;
    min-width: 13.6rem;
    min-height: 4.4rem;
    padding: 0.6rem 1.8rem;
    border-radius: 99rem;
    font-size: 1.6rem;
  }
  @media screen and (max-width: 359px) {
    .tfaq__contact {
      flex-direction: column;
      align-items: flex-start;
    }
    .tfaq .tfaq__contact .tolli-btn {
      width: 100%;
    }
  }

  /* ---------- Pick your sip ---------- */
  .tfaq__products {
    max-width: var(--faq-max);
    margin: 2.8rem auto 0;
  }
  .tfaq__products-title {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-bottom: 1.6rem !important;
    font-family: var(--tolli-font-display);
    font-weight: 400;
    font-size: clamp(3rem, 8.6vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--faq-navy);
  }
  .tfaq__products-title .tolli-hl {
    color: var(--faq-pink);
  }
  .tfaq__products-title .tfaq__burst {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.15em;
    margin-top: -0.05em;
  }
  .tfaq__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }
  .tfaq__card {
    display: grid;
    grid-template-columns: 46% 1fr;
    align-items: center;
    gap: 1.2rem;
    padding: 1.2rem 1.6rem 1.2rem 1rem;
    border-radius: 1.6rem;
    background: var(--card-bg);
    color: var(--faq-navy);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .tfaq__card--mint {
    --card-bg: var(--faq-mint);
  }
  .tfaq__card--blush {
    --card-bg: var(--faq-blush);
  }
  .tfaq__card-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    min-height: 15rem;
  }
  .tfaq__card-media img.tfaq__pouch {
    position: relative;
    z-index: 1;
    display: block;
    width: 82%;
    max-width: 20rem;
    height: auto;
    filter: drop-shadow(0 1rem 1.2rem rgba(0, 30, 45, 0.16));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tfaq__card-media .tfaq__strawberry {
    z-index: 2;
    left: -2%;
    bottom: 4%;
    width: 34%;
    max-width: 9.6rem;
  }
  .tfaq__card:hover .tfaq__pouch {
    transform: translateY(-4px) rotate(-1.5deg);
  }
  .tfaq__card-body {
    min-width: 0;
  }
  .tfaq__card-eyebrow {
    font-family: var(--tolli-font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    line-height: 1.05;
    color: var(--faq-navy);
  }
  .tfaq__card-title {
    font-family: var(--tolli-font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 5vw, 2.3rem);
    line-height: 1.1;
    color: var(--faq-navy);
  }
  .tfaq__card-specs {
    margin-top: 0.4rem !important;
    font-size: 1.45rem;
    line-height: 1.35;
  }
  .tfaq .tfaq__card .tolli-btn {
    margin-top: 1rem;
    min-height: 4.2rem;
    padding: 0.6rem 1.2rem;
    border-radius: 99rem;
    font-size: clamp(1.45rem, 4vw, 1.7rem);
    white-space: nowrap;
  }

  /* ---------- Tablet ---------- */
  @media screen and (min-width: 750px) {
    .tfaq__hero {
      padding-bottom: 8rem;
    }
    .tfaq__hero-inner {
      max-width: 60%;
      margin-left: 0;
    }
    .tfaq__title {
      font-size: clamp(4.8rem, 6.6vw, 7.2rem);
    }
    .tfaq__pills {
      display: flex;
    }
    .tfaq__wave {
      height: 5.6rem;
    }
    .tfaq__groups {
      max-width: 82rem;
      margin: 0 auto;
      gap: 4rem;
    }
    .tfaq__group-icon {
      width: 5.6rem;
      height: 5.6rem;
    }
    .tfaq__group-head {
      gap: 1.4rem;
      margin-bottom: 1.6rem;
    }
    .tfaq__list {
      border-radius: 2rem;
    }
    .tfaq__q {
      padding: 1.8rem 2.4rem 1.8rem 2.6rem;
    }
    .tfaq__q-text {
      font-size: 1.8rem;
    }
    .tfaq__a {
      padding: 0 6.4rem 2rem 2.6rem;
      font-size: 1.65rem;
    }
    .tfaq__chev {
      width: 2.6rem;
      height: 2.6rem;
    }
    .tfaq__leaves {
      top: -4rem;
      width: 13rem;
      right: calc(-1 * var(--tolli-gutter) - 2rem);
    }
    .tfaq__contact {
      margin-top: 5.6rem;
      padding: 3.2rem 4rem;
      border-radius: 2.8rem;
    }
    .tfaq .tfaq__contact .tolli-btn {
      min-height: 5.4rem;
      min-width: 22rem;
      padding: 0.8rem 3.2rem;
      font-size: 1.9rem;
    }
    .tfaq__products {
      margin-top: 6.4rem;
    }
    .tfaq__products-title {
      margin-bottom: 3.2rem !important;
    }
    .tfaq__cards {
      gap: 2rem;
    }
    .tfaq__card {
      grid-template-columns: 42% 1fr;
      padding: 2rem 3.2rem 2rem 2rem;
      border-radius: 2.4rem;
      gap: 2.4rem;
    }
    .tfaq__card-media {
      min-height: 24rem;
    }
    .tfaq__card-specs {
      font-size: 1.7rem;
    }
    .tfaq .tfaq__card .tolli-btn {
      width: auto;
      min-width: 24rem;
      min-height: 5rem;
      margin-top: 1.6rem;
      padding: 0.8rem 2.8rem;
      font-size: 1.8rem;
    }
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .tfaq__hero {
      min-height: calc(var(--faq-top-offset) + 46rem);
      display: flex;
      align-items: center;
      padding-bottom: 10rem;
    }
    .tfaq__hero > .tolli-container {
      width: 100%;
    }
    .tfaq__hero-inner {
      max-width: 62rem;
    }
    .tfaq__eyebrow {
      font-size: 1.5rem;
    }
    .tfaq__pills {
      display: none;
    }
    .tfaq__layout {
      display: grid;
      grid-template-columns: 28rem minmax(0, 1fr);
      align-items: start;
      gap: 6.4rem;
    }
    .tfaq__groups {
      max-width: none;
      margin: 0;
    }
    .tfaq__nav {
      display: block;
      position: sticky;
      top: calc(var(--header-height, 8rem) + 2.4rem);
      padding: 2.4rem 2rem;
      border-radius: 2.4rem;
      background: #fff;
      border: 1px solid rgba(var(--faq-navy-rgb), 0.08);
      box-shadow: 0 1.2rem 3.2rem rgba(var(--faq-navy-rgb), 0.06);
    }
    .tfaq__nav-label {
      margin: 0 0 1.2rem 0.8rem !important;
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faq-pink);
    }
    .tfaq__nav ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .tfaq__nav-link {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 1rem 0.8rem;
      border-radius: 1.4rem;
      color: var(--faq-navy);
      text-decoration: none;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .tfaq__nav-link svg {
      flex: none;
      width: 3.6rem;
      height: 3.6rem;
      color: var(--faq-pink);
    }
    .tfaq__nav-name {
      display: block;
      font-family: var(--tolli-font-display);
      font-size: 2rem;
      line-height: 1.1;
    }
    .tfaq__nav-count {
      display: block;
      font-size: 1.3rem;
      opacity: 0.7;
    }
    .tfaq__nav-link:hover,
    .tfaq__nav-link.is-active {
      background: var(--faq-blush);
      color: var(--faq-pink);
    }
    .tfaq__nav-help {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin: 1.6rem 0.8rem 0;
      padding-top: 1.6rem;
      border-top: 1px solid rgba(var(--faq-navy-rgb), 0.1);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--faq-navy);
      text-decoration: none;
    }
    .tfaq__nav-help svg {
      width: 1.6rem;
      height: 1.6rem;
      transition: transform 0.2s ease;
    }
    .tfaq__nav-help:hover {
      color: var(--faq-pink);
    }
    .tfaq__nav-help:hover svg {
      transform: translateX(3px);
    }
    .tfaq__group-title {
      font-size: 4.2rem;
    }
    .tfaq__leaves {
      right: calc(-1 * var(--tolli-gutter) - 4rem);
      width: 15rem;
    }
    .tfaq__wash {
      width: 60%;
    }
    .tfaq__cards {
      grid-template-columns: 1fr 1fr;
      gap: 2.4rem;
    }
    .tfaq__card {
      grid-template-columns: 44% 1fr;
      padding: 2.4rem 2.8rem 2.4rem 2rem;
    }
    .tfaq__card-eyebrow {
      font-size: 3rem;
    }
    .tfaq__card-title {
      font-size: 2.4rem;
    }
    .tfaq .tfaq__card .tolli-btn {
      width: 100%;
      min-width: 0;
    }
  }

  @media screen and (min-width: 1200px) {
    .tfaq__title {
      font-size: 7.6rem;
    }
    .tfaq__card {
      padding: 2.8rem 3.6rem 2.8rem 2.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tfaq__chev,
    .tfaq__pouch,
    .tfaq__pill {
      transition: none;
    }
    .tfaq__item::details-content {
      transition: none;
    }
  }
</style>

{%- capture burst_svg -%}
  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M9 30 23 8"/><path d="M17 36 34 20"/></svg>
{%- endcapture -%}
{%- capture chevron_svg -%}
  <svg class="tfaq__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9.5l6 6 6-6"/></svg>
{%- endcapture -%}
{%- assign contact_link = section.settings.contact_button_link | default: '/pages/contact' -%}

<div class="tolli-section tfaq">
  {%- comment -%} 1. Hero {%- endcomment -%}
  <div class="tfaq__hero">
    {%- liquid
      assign hero_bg = section.settings.hero_bg_image
      assign hero_bg_mobile = section.settings.hero_bg_image_mobile
    -%}
    {%- if hero_bg != blank -%}
      {%- assign hero_focal = hero_bg.presentation.focal_point | default: 'center' -%}
      <div
        class="tfaq__hero-bg{% if hero_bg_mobile != blank %} tfaq__hero-bg--has-mobile{% endif %}"
        style="--faq-hero-focal: {{ hero_focal }};"
        aria-hidden="true"
      >
        {{
          hero_bg
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2500, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      </div>
      {%- if hero_bg_mobile != blank -%}
        {%- assign hero_focal_mobile = hero_bg_mobile.presentation.focal_point | default: 'center' -%}
        <div
          class="tfaq__hero-bg tfaq__hero-bg--mobile"
          style="--faq-hero-focal: {{ hero_focal_mobile }};"
          aria-hidden="true"
        >
          {{
            hero_bg_mobile
            | image_url: width: 1500
            | image_tag:
              widths: '375, 550, 750, 1100, 1500',
              sizes: '100vw',
              loading: 'eager',
              alt: ''
          }}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Placeholder until a hero background is uploaded {%- endcomment -%}
      <div class="tfaq__hero-bg" aria-hidden="true">
        <img src="{{ 'tolli-bg-leaves.jpg' | asset_url }}" width="2000" height="803" alt="" loading="eager">
      </div>
    {%- endif -%}

    <div class="tolli-container">
      <div class="tfaq__hero-inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tfaq__eyebrow">
            <span class="tfaq__burst">{{ burst_svg }}</span>
            <span>{{ section.settings.eyebrow | escape }}</span>
          </p>
        {%- endif -%}
        <h1 class="tfaq__title">
          <span class="tfaq__title-line">{{ section.settings.title_line_1 | escape }}</span>
          <span class="tfaq__title-line tfaq__title-line--hl">
            {{- section.settings.title_line_2 | escape -}}
            <span class="tfaq__burst">{{ burst_svg }}</span>
          </span>
        </h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="tfaq__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        <nav class="tfaq__pills" aria-label="FAQ categories">
          {%- for key in cat_keys -%}
            {%- liquid
              assign idx = forloop.index0
              assign title_key = 'cat_' | append: forloop.index | append: '_title'
              assign icon_key = 'cat_' | append: forloop.index | append: '_icon'
              assign cat_title = section.settings[title_key] | default: cat_default_titles[idx]
              assign cat_icon = section.settings[icon_key] | default: cat_default_icons[idx]
            -%}
            <a class="tfaq__pill" href="#faq-{{ key }}">
              {%- render 'tolli-icon', icon: cat_icon -%}
              <span>{{ cat_title | escape }}</span>
            </a>
          {%- endfor -%}
        </nav>
      </div>
    </div>

    <svg class="tfaq__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 34C190 8 420 2 660 18s470 30 780 6V60H0Z"/></svg>
  </div>

  {%- comment -%} 2. Questions {%- endcomment -%}
  <div class="tfaq__body">
    <div class="tolli-container">
      <div class="tfaq__layout">
        <aside class="tfaq__nav" aria-label="FAQ categories">
          <p class="tfaq__nav-label">{{ section.settings.nav_label | escape }}</p>
          <ul>
            {%- for key in cat_keys -%}
              {%- liquid
                assign idx = forloop.index0
                assign title_key = 'cat_' | append: forloop.index | append: '_title'
                assign icon_key = 'cat_' | append: forloop.index | append: '_icon'
                assign cat_title = section.settings[title_key] | default: cat_default_titles[idx]
                assign cat_icon = section.settings[icon_key] | default: cat_default_icons[idx]
                assign cat_count = 0
                for b in section.blocks
                  if b.type == 'question' and b.settings.category == key
                    assign cat_count = cat_count | plus: 1
                  endif
                endfor
              -%}
              {%- if cat_count > 0 -%}
                <li>
                  <a class="tfaq__nav-link" href="#faq-{{ key }}" data-faq-link="faq-{{ key }}">
                    {%- render 'tolli-icon', icon: cat_icon -%}
                    <span>
                      <span class="tfaq__nav-name">{{ cat_title | escape }}</span>
                      <span class="tfaq__nav-count">
                        {{- cat_count }}
                        {% if cat_count == 1 %}question{% else %}questions{% endif -%}
                      </span>
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if section.settings.contact_button_label != blank -%}
            <a class="tfaq__nav-help" href="{{ contact_link }}">
              <span>{{ section.settings.contact_title | escape }} {{ section.settings.contact_button_label | escape }}</span>
              {%- render 'tolli-icon', icon: 'arrow' -%}
            </a>
          {%- endif -%}
        </aside>

        <div class="tfaq__groups">
          {%- for key in cat_keys -%}
            {%- liquid
              assign idx = forloop.index0
              assign title_key = 'cat_' | append: forloop.index | append: '_title'
              assign icon_key = 'cat_' | append: forloop.index | append: '_icon'
              assign cat_title = section.settings[title_key] | default: cat_default_titles[idx]
              assign cat_icon = section.settings[icon_key] | default: cat_default_icons[idx]
              assign cat_count = 0
              for b in section.blocks
                if b.type == 'question' and b.settings.category == key
                  assign cat_count = cat_count | plus: 1
                endif
              endfor
            -%}
            {%- if cat_count > 0 -%}
              <section id="faq-{{ key }}" class="tfaq__group" aria-labelledby="faq-{{ key }}-title">
                {%- if key == 'mix' and section.settings.show_leaves -%}
                  <svg class="tfaq__wash" viewBox="0 0 300 200" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M300 0v200H120C60 196 22 170 40 132c14-30 70-36 76-70C122 26 170 2 230 0Z"/></svg>
                  <svg class="tfaq__leaves" viewBox="0 0 130 240" aria-hidden="true" focusable="false">
                    <path d="M126 2C104 48 92 108 104 238" fill="none" stroke="#5DAE6E" stroke-width="3" stroke-linecap="round"/>
                    <g transform="translate(119 26) rotate(-158)"><path d="M0 0C10-12 32-14 50 0 32 14 10 12 0 0Z" fill="#7CC77F"/><path d="M2 0h44" stroke="#5DAE6E" stroke-width="1.6" stroke-linecap="round" opacity=".7"/></g>
                    <g transform="translate(112 50) rotate(-196)"><path d="M0 0C12-14 38-16 58 0 38 16 12 14 0 0Z" fill="#9BD58A"/><path d="M2 0h52" stroke="#6DB46F" stroke-width="1.6" stroke-linecap="round" opacity=".7"/></g>
                    <g transform="translate(106 78) rotate(-150)"><path d="M0 0C14-16 42-18 66 0 42 18 14 16 0 0Z" fill="#63B86C"/><path d="M2 0h60" stroke="#4F9F5D" stroke-width="1.8" stroke-linecap="round" opacity=".7"/></g>
                    <g transform="translate(102 108) rotate(-200)"><path d="M0 0C14-16 42-18 66 0 42 18 14 16 0 0Z" fill="#86CB7E"/><path d="M2 0h60" stroke="#5DAE6E" stroke-width="1.8" stroke-linecap="round" opacity=".7"/></g>
                    <g transform="translate(100 140) rotate(-146)"><path d="M0 0C16-18 46-20 72 0 46 20 16 18 0 0Z" fill="#57AE66"/><path d="M2 0h66" stroke="#468F53" stroke-width="1.8" stroke-linecap="round" opacity=".7"/></g>
                    <g transform="translate(100 172) rotate(-204)"><path d="M0 0C14-16 42-18 64 0 42 18 14 16 0 0Z" fill="#9BD58A"/><path d="M2 0h58" stroke="#6DB46F" stroke-width="1.6" stroke-linecap="round" opacity=".7"/></g>
                    <g transform="translate(102 204) rotate(-156)"><path d="M0 0C12-14 36-16 56 0 36 16 12 14 0 0Z" fill="#6DBE73"/><path d="M2 0h50" stroke="#4F9F5D" stroke-width="1.6" stroke-linecap="round" opacity=".7"/></g>
                  </svg>
                {%- endif -%}

                <div class="tfaq__group-head">
                  <span class="tfaq__group-icon" aria-hidden="true">{%- render 'tolli-icon', icon: cat_icon -%}</span>
                  <h2 class="tfaq__group-title" id="faq-{{ key }}-title">
                    {{- cat_title | escape -}}
                    <span class="tfaq__burst{% if cat_bursts[idx] == 'yellow' %} tfaq__burst--yellow{% endif %}">{{ burst_svg }}</span>
                  </h2>
                </div>

                <div class="tfaq__list">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'question' and block.settings.category == key -%}
                      <details class="tfaq__item"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
                        <summary class="tfaq__q">
                          <span class="tfaq__q-text">{{ block.settings.question | escape }}</span>
                          {{ chevron_svg }}
                        </summary>
                        <div class="tfaq__a">{{ block.settings.answer }}</div>
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </section>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} 3. Still curious? {%- endcomment -%}
      {%- if section.settings.contact_title != blank or section.settings.contact_button_label != blank -%}
        <div class="tfaq__contact">
          <div>
            <h2 class="tfaq__contact-title">
              {{- section.settings.contact_title | escape -}}
              <span class="tfaq__burst">{{ burst_svg }}</span>
            </h2>
            {%- if section.settings.contact_text != blank -%}
              <p class="tfaq__contact-text">{{ section.settings.contact_text | escape }}</p>
            {%- endif -%}
          </div>
          {%- if section.settings.contact_button_label != blank -%}
            <a class="tolli-btn" href="{{ contact_link }}">
              <span>{{ section.settings.contact_button_label | escape }}</span>
              {%- render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 4. Pick your sip {%- endcomment -%}
      {%- if section.settings.show_product_cards -%}
        {%- liquid
          assign products_heading = section.settings.products_heading | default: 'Pick your [sip.]'
          assign products_heading_html = products_heading | escape | replace: '[', '<span class="tolli-hl">' | replace: ']', '</span>'
        -%}
        <div class="tfaq__products">
          <h2 class="tfaq__products-title">
            <span>{{ products_heading_html }}</span>
            <span class="tfaq__burst">{{ burst_svg }}</span>
          </h2>

          <div class="tfaq__cards">
            {%- for i in (1..2) -%}
              {%- liquid
                assign k = 'card_' | append: i | append: '_'
                assign k_image = k | append: 'image'
                assign k_eyebrow = k | append: 'eyebrow'
                assign k_title = k | append: 'title'
                assign k_specs = k | append: 'specs'
                assign k_btn = k | append: 'btn'
                assign k_link = k | append: 'link'
                if i == 1
                  assign card_mod = 'mint'
                  assign fallback_img = 'tolli-pouch-hydration.png'
                  assign fallback_w = 374
                  assign fallback_h = 522
                  assign fallback_link = '/products/tolli-hydration-strawberry-lemonade'
                else
                  assign card_mod = 'blush'
                  assign fallback_img = 'tolli-pouch-protein.png'
                  assign fallback_w = 293
                  assign fallback_h = 366
                  assign fallback_link = '/products/tolli-clear-protein-raspberry-lemonade'
                endif
                assign card_alt = section.settings[k_eyebrow] | append: ' ' | append: section.settings[k_title]
                assign card_link = section.settings[k_link] | default: fallback_link
              -%}
              <article class="tfaq__card tfaq__card--{{ card_mod }}">
                <div class="tfaq__card-media">
                  {%- if section.settings[k_image] != blank -%}
                    {{
                      section.settings[k_image]
                      | image_url: width: 600
                      | image_tag:
                        class: 'tfaq__pouch',
                        widths: '300, 450, 600',
                        sizes: '(min-width: 990px) 20vw, 45vw',
                        loading: 'lazy',
                        alt: card_alt
                    }}
                  {%- else -%}
                    <img class="tfaq__pouch" src="{{ fallback_img | asset_url }}" width="{{ fallback_w }}" height="{{ fallback_h }}" alt="{{ card_alt | escape }}" loading="lazy">
                    {%- if i == 1 and section.settings.show_fruit -%}
                      <img class="tfaq__strawberry" src="{{ 'tolli-strawberry.png' | asset_url }}" width="190" height="181" alt="" loading="lazy" aria-hidden="true">
                    {%- endif -%}
                  {%- endif -%}
                </div>
                <div class="tfaq__card-body">
                  <h3 class="tfaq__card-eyebrow">{{ section.settings[k_eyebrow] | escape }}</h3>
                  <p class="tfaq__card-title">{{ section.settings[k_title] | escape }}</p>
                  {%- if section.settings[k_specs] != blank -%}
                    <p class="tfaq__card-specs">{{ section.settings[k_specs] | escape | newline_to_br }}</p>
                  {%- endif -%}
                  {%- if section.settings[k_btn] != blank -%}
                    <a class="tolli-btn" href="{{ card_link }}">
                      <span>{{ section.settings[k_btn] | escape }}</span>
                      {%- render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' -%}
                    </a>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || !('IntersectionObserver' in window)) return;
    var links = root.querySelectorAll('[data-faq-link]');
    if (!links.length) return;
    var setActive = function (id) {
      links.forEach(function (link) {
        link.classList.toggle('is-active', link.getAttribute('data-faq-link') === id);
      });
    };
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-35% 0px -55% 0px' }
    );
    root.querySelectorAll('.tfaq__group').forEach(function (group) {
      observer.observe(group);
    });
  })();
</script>

{%- comment -%} Structured data for FAQPage {%- endcomment -%}
{%- assign faq_blocks = section.blocks | where: 'type', 'question' -%}
{%- if faq_blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign is_first_item = true -%}
        {%- for block in faq_blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- unless is_first_item %},{% endunless -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }
            {%- assign is_first_item = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

