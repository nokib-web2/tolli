      "id": "text",
      "label": "Text",
      "default": "Be first to hear about new flavours, launch offers and good-vibe drops."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join"
    },
    {
      "type": "text",
      "id": "note",
