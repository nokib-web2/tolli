    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Wrap words in [brackets] to highlight them. Use | for a line break.",
      "default": "Join the [tolli club.]"
