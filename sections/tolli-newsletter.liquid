      "label": "Card text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (highlight, sun)",
      "default": "#FFDC32"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ED0056"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFDF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_color",
