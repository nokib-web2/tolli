{%- comment -%}
  Shared per-section CSS variables: background, text colour, highlight colour,
  heading sizes and vertical padding. Every tolli-* content section declares
  the matching settings (background, text_color, highlight_color,
  title_size_mobile, title_size_desktop, padding_*).
  Usage: {% render 'tolli-section-style', section: section %}
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} > .tolli-section {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --tolli-text: {{ section.settings.text_color }};
    --tolli-head-hl: {{ section.settings.highlight_color }};
    --tolli-title-m: {{ section.settings.title_size_mobile }}px;
    --tolli-title-d: {{ section.settings.title_size_desktop }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .tolli-section {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}
