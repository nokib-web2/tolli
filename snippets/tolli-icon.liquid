{%- comment -%}
  Tolli brand icons.
  Usage: {% render 'tolli-icon', icon: 'arrow', class: 'tolli-btn__arrow' %}
  Icons: arrow, burst, burst-small, sun, leaf, swoosh
{%- endcomment -%}
{%- case icon -%}
  {%- when 'arrow' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"/><path d="M13 5.5 19.5 12 13 18.5"/></svg>
  {%- when 'burst' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linecap="round"><path d="M27 15 19 4"/><path d="M25 23 8 15.5"/><path d="M25.5 31 12.5 33"/></svg>
  {%- when 'burst-small' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"><path d="M10 31 26 9"/><path d="M17 36 35 22"/></svg>
  {%- when 'sun' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"><circle cx="50" cy="50" r="17"/><path d="M50 8v13M50 79v13M8 50h13M79 50h13M20.3 20.3l9.2 9.2M70.5 70.5l9.2 9.2M20.3 79.7l9.2-9.2M70.5 29.5l9.2-9.2"/></svg>
  {%- when 'leaf' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 48 64" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 60C8 44 14 30 30 18c4-3 7-7 9-14 4 12 3 26-6 36-6 7-14 9-23 20Z"/><path d="M10 60c6-14 13-24 22-33"/><path d="M5 40C2 32 4 24 11 18c1 7 4 12 3 19"/></svg>
  {%- when 'drop' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#8ED8F8" d="M12 2.8s-6.5 7.3-6.5 11.7a6.5 6.5 0 0 0 13 0C18.5 10.1 12 2.8 12 2.8Z"/><path stroke="#fff" stroke-width="2" d="M8.9 14.6a3.1 3.1 0 0 0 2.6 3.1"/></svg>
  {%- when 'zero-sugar' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#FFF6C9" d="m12 3.2 7.3 4.1L12 11.4 4.7 7.3Z"/><path fill="#FFDC32" d="M4.7 7.3 12 11.4v8.4l-7.3-4.1Z"/><path fill="#F5C400" d="M19.3 7.3 12 11.4v8.4l7.3-4.1Z"/><path stroke="#ED0056" stroke-width="2.6" d="M3.5 20.5 20.5 3.5"/></svg>
  {%- when 'protein' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#FFDC32" d="M13.4 2.5 5 13.6h6.2l-1.1 7.9 8.5-11.3h-6.3Z"/><path stroke="#ED0056" d="M19.5 3.5l1.2-1.2M21 7h1.4"/></svg>
  {%- when 'plant' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#6FD3A0" d="M5 19.5C5 11 10 5.6 20.5 4.5 19.6 15 14.2 20 5.8 20"/><path d="M5 19.5c3.2-4.3 6.3-7.3 10.4-9.4"/></svg>
  {%- when 'heart' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#FF6F9C" d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20Z"/><path stroke="#fff" stroke-width="1.8" d="M7.6 9.6a2 2 0 0 1 1.6-1.4"/></svg>
  {%- when 'sparkle' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#FFDC32" d="M11 3c.7 4.6 2.4 6.3 7 7-4.6.7-6.3 2.4-7 7-.7-4.6-2.4-6.3-7-7 4.6-.7 6.3-2.4 7-7Z"/><path fill="#FF6F9C" d="M18.5 15.5c.3 1.6.9 2.2 2.5 2.5-1.6.3-2.2.9-2.5 2.5-.3-1.6-.9-2.2-2.5-2.5 1.6-.3 2.2-.9 2.5-2.5Z"/></svg>
  {%- when 'scoop' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#FF9EBB" d="M5.2 11.2c.4-2.6 2.5-4.3 5-4.3s4.5 1.7 4.9 4.3Z"/><path fill="#E4F5FC" d="M3.5 11.5h11a5.5 5.5 0 0 1-11 0Z"/><path d="M14.5 11.5 21 6"/><circle cx="17.5" cy="4.5" r=".9" fill="#ED0056" stroke="none"/><circle cx="20" cy="9.5" r=".7" fill="#ED0056" stroke="none"/></svg>
  {%- when 'glass' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#E4F5FC" d="M5.5 4h13l-1.6 15.2a2 2 0 0 1-2 1.8H9.1a2 2 0 0 1-2-1.8Z"/><path fill="#FF8FB1" stroke="none" d="M6.4 10.5c2-1 3.7-1 5.6 0s3.6 1 5.6 0l-.9 8.6a1.6 1.6 0 0 1-1.6 1.4H9a1.6 1.6 0 0 1-1.6-1.4Z"/><path d="M5.5 4h13l-1.6 15.2a2 2 0 0 1-2 1.8H9.1a2 2 0 0 1-2-1.8Z"/><circle cx="17.8" cy="4.6" r="3" fill="#FFDC32"/><path d="M17.8 2.6v4M15.8 4.6h4"/></svg>
  {%- when 'smile' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="#FFDC32"/><path d="M8.5 14.2a4.5 4.5 0 0 0 7 0M9 9.5h.01M15 9.5h.01"/><circle cx="7.2" cy="13" r="1" fill="#FF8FB1" stroke="none"/><circle cx="16.8" cy="13" r="1" fill="#FF8FB1" stroke="none"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6h11v10h-11zM13.5 9.5h4l3 3.5V16h-7z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path fill="#6FD3A0" d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6Z"/><path stroke="#fff" stroke-width="2.2" d="m8.8 12 2.2 2.2 4.2-4.4"/></svg>
  {%- when 'star' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9Z"/></svg>
  {%- when 'x' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M7 7l10 10M17 7 7 17"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 12h12"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'mail' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
  {%- when 'lock' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2.5" fill="currentColor"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
  {%- when 'check' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5 19 7"/></svg>
  {%- when 'swoosh' -%}
    <svg class="{{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 200 20" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"><path d="M4 14C50 6 120 4 196 9"/></svg>
{%- endcase -%}
